<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.madoka.office</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/REVIEWED/CHECKOUT/.venv/bin/python</string>
    <string>/ABSOLUTE/REVIEWED/CHECKOUT/madoka_office.py</string>
    <string>--serve</string><string>--config</string>
    <string>/ABSOLUTE/PRIVATE/office.json</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/REVIEWED/CHECKOUT</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
</dict></plist>
